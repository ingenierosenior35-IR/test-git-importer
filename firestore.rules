rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ───────────────────────────────────────────────────────────────
    // Each user can read and write their own document and sub-collections.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Favourite teams stored under users/{uid}/favorite_teams/{docId}
      match /favorite_teams/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Polls ────────────────────────────────────────────────────────────────
    // Authenticated users can:
    //   • Create a poll where they are the creator and initial participant.
    //   • Read polls they created or are a participant of.
    //   • Update polls to add themselves as a participant (join by code).
    //   • Delete polls they created.
    match /polls/{pollId} {
      // Any authenticated user can read a poll (needed to look up by join code
      // and to display public standings). Restrict further if needed.
      allow read: if request.auth != null;

      // Create: must be signed in, creatorId must match uid, and uid must be
      // in participantIds so that subsequent queries work.
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds;

      // Update: creator can change anything; any participant can add themselves.
      allow update: if request.auth != null && (
        resource.data.creatorId == request.auth.uid
        || (
          // Only allow adding current user to participantIds, nothing else.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds'])
          && request.auth.uid in request.resource.data.participantIds
        )
      );

      // Delete: only the creator.
      allow delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;

      // Predictions sub-collection: participants can write their own predictions.
      match /predictions/{predId} {
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/polls/$(pollId)).data.creatorId == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/polls/$(pollId)).data.participantIds
          );
        allow write: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/polls/$(pollId)).data.participantIds;
      }
    }
  }
}
